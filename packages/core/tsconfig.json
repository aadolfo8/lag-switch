{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // `core` runs both in Node (server) and in the browser (client prediction).
    // No DOM lib and no @types/node: any accidental use of `window`, `document`,
    // `process`, `Buffer`… is a compile error here.
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src", "test"]
}
