{
  "name": "@lag-switch/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server: native WebSocket gateway, rooms, 30 Hz tick loop, network conditioner and bot.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lag-switch/core": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-ws": "^11.2.10",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/websockets": "^11.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
