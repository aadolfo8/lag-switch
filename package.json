{
  "name": "lag-switch",
  "private": true,
  "license": "MIT",
  "description": "A 1v1 top-down duel where the weapons are everything that goes wrong when you play online.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "biome ci . && turbo run typecheck test build && playwright test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.11",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
